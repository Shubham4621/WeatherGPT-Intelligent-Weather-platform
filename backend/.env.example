# =============================================================================
# WeatherGPT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# --- Weather Provider (OpenWeatherMap) ---
# Sign up free at https://openweathermap.org/api and paste your key below.
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Official IMD district warnings ---
IMD_DISTRICT_WARNING_URL=https://mausam.imd.gov.in/api/warnings_district_api.php
IMD_ALERT_TIMEOUT=10
IMD_ALERT_CACHE_TTL_SECONDS=900
# Fill only with a district object ID verified from an official IMD source.
IMD_DHULE_OBJ_ID=

# --- Application ---
ENVIRONMENT=development
WEATHERGPT_DEBUG=true

# --- Database (PostgreSQL + PostGIS — future phases) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weathergpt

# --- Redis Cache (future phases) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM intent service (Ollama runs locally; API key is optional) ---
LLM_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT=45
